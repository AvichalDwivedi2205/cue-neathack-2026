# Local demo only. Never use this bypass on a shared host.
CUE_LOCAL_DEMO=true
CUE_DEMO_SECRET=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
CONVEX_DEPLOYMENT=

# Vertex AI uses Application Default Credentials; Gemini API key is an alternative.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=

# Existing Codex ChatGPT login. Override only if the CLI is not on PATH.
# CUE_CODEX_PATH=
CUE_GITHUB_REPO=

# Compressed browser voice audio requires an installed FFmpeg binary.
# Install it on the server; set an absolute path when it is not on PATH.
# CUE_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# Natural reply audio uses Google Cloud Text-to-Speech with server ADC.
# Enable texttospeech.googleapis.com; the runtime needs serviceusage.services.use.
# Uses GOOGLE_CLOUD_PROJECT by default; no browser credentials or stored audio.
# CUE_TTS_PROJECT=
# CUE_TTS_VOICE=en-US-Chirp3-HD-Aoede

# AuthKit. Set the same callback in the WorkOS dashboard.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# Optional server runtime override for a hosted container's registered callback.
# CUE_WORKOS_REDIRECT_URI=https://your-host/auth/callback
CUE_OPERATOR_EMAIL=

# Pipes provider ID and verified Slack app event/interaction credentials.
WORKOS_SLACK_PROVIDER=slack
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_SUPPORT_CHANNEL_ID=
SLACK_TEAM_CHANNEL_ID=
SLACK_OPERATOR_IDS=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# Verified inbound/outbound email.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CUE_EMAIL_FROM=
# CUE_EMAIL_REPLY_TO=
# Optional notification email import. No X or Reddit API requests are made.
# CUE_EMAIL_NOTIFICATIONS=true
# Optional local receiving polling; no public webhook needed for notifications.
# CUE_EMAIL_POLL=true
# CUE_EMAIL_POLL_RECIPIENT=mentions@your-id.resend.app
# Optional separate inbox for ordinary customer support email.
# CUE_EMAIL_SUPPORT_RECIPIENT=support@your-id.resend.app
# Public HTTPS origin when hosting the installable widget outside localhost.
# CUE_PUBLIC_URL=

# Hosted gateway + local worker share encrypted integration configuration.
# CUE_CONVEX_URL=https://your-production-deployment.convex.cloud
# CUE_SHARED_CONFIG=true
# CUE_HOSTED_UPLOAD=true
# CUE_RELEASE_COMMIT=
## neatHack observability (server/worker only; never NEXT_PUBLIC)
NEATLOGS_API_KEY=
# CUE_TELEMETRY_LOCAL=1 captures locally without exporting.
